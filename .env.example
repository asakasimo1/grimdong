# 아이담 환경 변수 예시
# 이 파일을 복사해서 .env.local 로 만들고 실제 값을 입력하세요
# cp .env.example .env.local

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_KAKAO_JS_KEY=your_kakao_javascript_key

# api/context.js 전용 (서버사이드 전용 — VITE_ 접두사 붙이지 말 것,
# 붙이면 브라우저 번들에 노출됨). Personal AI Brain 그림일기 배경지식 브릿지.
AIBRAIN_BRIDGE_URL=https://hskadvisor.duckdns.org/api/aiddam/context
AIBRAIN_BRIDGE_SECRET=your_shared_secret_matching_ai_brain_server
